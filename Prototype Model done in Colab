      "source": [
        "\n",
        "\n",
        "import os\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import yfinance as yf\n",
        "from datetime import date\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, r2_score\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout\n",
        "\n",
        "# ----- Config -----\n",
        "START = \"2022-01-01\"\n",
        "TODAY = date.today().strftime(\"%Y-%m-%d\")\n",
        "TICKER = \"TCS.NS\"\n",
        "WINDOW_SIZE = 100\n",
        "EPOCHS = 30\n",
        "MODEL_SAVE_PATH = \"keras_model.h5\"\n",
        "RANDOM_SEED = 42\n",
        "np.random.seed(RANDOM_SEED)\n",
        "tf.random.set_seed(RANDOM_SEED)\n",
        "\n",
        "\n",
        "def load_data(ticker: str, start: str = START, end: str = TODAY) -> pd.DataFrame:\n",
        "    df = yf.download(ticker, start=start, end=end, progress=False)\n",
        "    if df.empty:\n",
        "        raise ValueError(f\"No data fetched for ticker '{ticker}' in range {start}..{end}\")\n",
        "    df.reset_index(inplace=True)\n",
        "    return df\n",
        "\n",
        "\n",
        "def prepare_train_test(df: pd.DataFrame, window: int = WINDOW_SIZE, train_fraction: float = 0.7):\n",
        "    df = df[['Date', 'Close']].copy()\n",
        "    df.sort_values('Date', inplace=True)\n",
        "    df.reset_index(drop=True, inplace=True)\n",
        "\n",
        "    # Split indices\n",
        "    split_idx = int(len(df) * train_fraction)\n",
        "    train_df = df.iloc[:split_idx].copy()\n",
        "    test_df = df.iloc[split_idx:].copy()\n",
        "    return train_df, test_df\n",
        "\n",
        "\n",
        "def create_sequences(values: np.ndarray, window: int):\n",
        "    \"\"\"\n",
        "    values: 1D or 2D array shaped (n_samples, 1) expected\n",
        "    returns x (n, window, 1), y (n,)\n",
        "    \"\"\"\n",
        "    x, y = [], []\n",
        "    for i in range(window, len(values)):\n",
        "        x.append(values[i - window:i, 0])\n",
        "        y.append(values[i, 0])\n",
        "    x = np.array(x)\n",
        "    y = np.array(y)\n",
        "    x = np.reshape(x, (x.shape[0], x.shape[1], 1))\n",
        "    return x, y\n",
        "\n",
        "\n",
        "def build_model(input_shape):\n",
        "    model = Sequential()\n",
        "    model.add(LSTM(units=50, activation='relu', return_sequences=True, input_shape=input_shape))\n",
        "    model.add(Dropout(0.2))\n",
        "    model.add(LSTM(units=60, activation='relu', return_sequences=True))\n",
        "    model.add(Dropout(0.3))\n",
        "    model.add(LSTM(units=80, activation='relu', return_sequences=True))\n",
        "    model.add(Dropout(0.4))\n",
        "    model.add(LSTM(units=120, activation='relu'))\n",
        "    model.add(Dropout(0.5))\n",
        "    model.add(Dense(units=1))\n",
        "    model.compile(optimizer='adam', loss='mean_squared_error', metrics=['mae'])\n",
        "    return model\n",
        "\n",
        "\n",
        "def main():\n",
        "    print(\"Loading data for\", TICKER)\n",
        "    df = load_data(TICKER, START, TODAY)\n",
        "    print(\"Downloaded rows:\", len(df))\n",
        "\n",
        "    train_df, test_df = prepare_train_test(df, WINDOW_SIZE)\n",
        "    print(\"Train rows:\", len(train_df), \"Test rows:\", len(test_df))\n",
        "\n",
        "    # Fit scaler on training close prices only\n",
        "    scaler = MinMaxScaler(feature_range=(0, 1))\n",
        "    train_close = train_df[['Close']].values\n",
        "    test_close = test_df[['Close']].values\n",
        "\n",
        "    scaler.fit(train_close)  # fit only on training data\n",
        "\n",
        "    train_scaled = scaler.transform(train_close)          # shape (n_train, 1)\n",
        "    # For test, we'll build the input containing last 'window' days from train + test\n",
        "    last_train_window = train_close[-WINDOW_SIZE:] if len(train_close) >= WINDOW_SIZE else train_close\n",
        "    combined_for_test = np.vstack((last_train_window, test_close))\n",
        "    combined_scaled = scaler.transform(combined_for_test)\n",
        "\n",
        "    # Create training sequences\n",
        "    x_train, y_train = create_sequences(train_scaled, WINDOW_SIZE)\n",
        "    print(\"x_train shape:\", x_train.shape, \"y_train shape:\", y_train.shape)\n",
        "\n",
        "    # Create test sequences from combined_for_test (which includes last WINDOW_SIZE of train)\n",
        "    x_test, y_test = create_sequences(combined_scaled, WINDOW_SIZE)\n",
        "    print(\"x_test shape:\", x_test.shape, \"y_test shape:\", y_test.shape)\n",
        "\n",
        "    # Build model\n",
        "    model = build_model((x_train.shape[1], 1))\n",
        "    model.summary()\n",
        "\n",
        "    # Train model. Use validation_data from x_test/y_test to monitor test performance during training.\n",
        "    # (Alternatively use validation_split on training data.)\n",
        "    history = model.fit(\n",
        "        x_train, y_train,\n",
        "        epochs=EPOCHS,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        validation_data=(x_test, y_test),\n",
        "        shuffle=True\n",
        "    )\n",
        "\n",
        "    # Save model\n",
        "    model.save(MODEL_SAVE_PATH)\n",
        "    print(\"Model saved to\", MODEL_SAVE_PATH)\n",
        "\n",
        "    # Predictions\n",
        "    y_pred_scaled = model.predict(x_test)\n",
        "    # Inverse transform predictions and true values\n",
        "    # scaler expects 2D arrays: reshape back\n",
        "    y_pred = scaler.inverse_transform(y_pred_scaled)\n",
        "    y_true = scaler.inverse_transform(y_test.reshape(-1, 1))\n",
        "\n",
        "    # Metrics\n",
        "    mae = mean_absolute_error(y_true, y_pred)\n",
        "    mae_percentage = (mae / np.mean(y_true)) * 100\n",
        "    r2 = r2_score(y_true, y_pred)\n",
        "\n",
        "    print(f\"Mean absolute error: {mae:.4f} (relative: {mae_percentage:.2f}%)\")\n",
        "    print(f\"R2 score: {r2:.4f}\")\n",
        "\n",
        "    # Plot original vs predicted (for test set)\n",
        "    plt.figure(figsize=(12, 6))\n",
        "    plt.plot(y_true, label='Original Price')\n",
        "    plt.plot(y_pred, label='Predicted Price')\n",
        "    plt.xlabel('Time (test samples)')\n",
        "    plt.ylabel('Price')\n",
        "    plt.title(f'{TICKER} - Original vs Predicted (R2={r2:.3f})')\n",
        "    plt.legend()\n",
        "    plt.grid(True)\n",
        "    plt.show()\n",
        "\n",
        "    # Scatter plot for R2 visualization\n",
        "    plt.figure(figsize=(8, 6))\n",
        "    plt.scatter(y_true, y_pred, alpha=0.5)\n",
        "    minv = min(y_true.min(), y_pred.min())\n",
        "    maxv = max(y_true.max(), y_pred.max())\n",
        "    plt.plot([minv, maxv], [minv, maxv], 'r--')  # identity line\n",
        "    plt.xlabel('Actual Values')\n",
        "    plt.ylabel('Predicted Values')\n",
        "    plt.title(f'Actual vs Predicted (R2: {r2:.3f})')\n",
        "    plt.grid(True)\n",
        "    plt.show()\n",
        "\n",
        "    # Plot training history (loss)\n",
        "    plt.figure(figsize=(10, 4))\n",
        "    plt.plot(history.history['loss'], label='train_loss')\n",
        "    plt.plot(history.history['val_loss'], label='val_loss')\n",
        "    plt.xlabel('Epoch')\n",
        "    plt.ylabel('Loss (MSE)')\n",
        "    plt.title('Training & Validation Loss')\n",
        "    plt.legend()\n",
        "    plt.grid(True)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()\n",
        "\n"
      ],
